# Postgres — auto-set by Vercel when a Postgres (Neon) store is attached to the project.
# For local dev, run `vercel env pull .env.local` after attaching the store, or paste the
# connection string from the Vercel dashboard / Neon console.
POSTGRES_URL=

# Resend — used to send a notification email to info@aivik.eu on every submission.
# https://resend.com/api-keys
RESEND_API_KEY=

# Google Sheets — appends a row per submission for a spreadsheet view of inquiries.
# Create a Google Cloud service account, enable the Sheets API, share the target sheet
# with the service account's email as an Editor, and paste its credentials here.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Anthropic — powers the chat widget (app/components/ChatWidget.tsx, app/api/chat).
# Without this set, the widget stays up but replies with a "chat's not switched on" message.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Sanity — the blog's content (the editor is in /studio, live at https://aivik.sanity.studio).
# Published articles are read without a token. These two are for the extras:
# a read-only (Viewer) token so editors can preview drafts from the Studio, and the
# secret that signs the publish webhook calling /api/revalidate.
# https://www.sanity.io/manage/project/qs3r3e0a/api
SANITY_READ_TOKEN=
SANITY_WEBHOOK_SECRET=
